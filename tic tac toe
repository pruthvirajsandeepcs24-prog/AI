board = [' '] * 9

def print_board():
    print(board[0], '|', board[1], '|', board[2])
    print(board[3], '|', board[4], '|', board[5])
    print(board[6], '|', board[7], '|', board[8])

def check_win(player):
    win_positions = [(0,1,2),(3,4,5),(6,7,8),
                     (0,3,6),(1,4,7),(2,5,8),
                     (0,4,8),(2,4,6)]
    for a, b, c in win_positions:
        if board[a] == board[b] == board[c] == player:
            return True
    return False

def board_full():
    return ' ' not in board

def computer_move():
    # play the first empty cell found (simple rule, no search algorithm)
    for i in range(9):
        if board[i] == ' ':
            board[i] = 'O'
            break

# Main game loop
turn = 'human'
while True:
    print_board()

    if turn == 'human':
        pos = int(input("Enter position (0-8): "))
        if board[pos] == ' ':
            board[pos] = 'X'
        else:
            print("Cell already taken, try again")
            continue
        if check_win('X'):
            print_board()
            print("You win!")
            break
        turn = 'computer'

    else:
        computer_move()
        if check_win('O'):
            print_board()
            print("Computer wins!")
            break
        turn = 'human'

    if board_full():
        print_board()
        print("It's a draw!")
        break

