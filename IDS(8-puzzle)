GOAL = [8, 7, 6,
        0, 5, 4,
        3, 2, 1]


def print_state(state):
    print(state[0], state[1], state[2])
    print(state[3], state[4], state[5])
    print(state[6], state[7], state[8])
    print()


def get_neighbors(state):
    neighbors = []

    zero = state.index(0)
    row = zero // 3
    col = zero % 3

    moves = [
        (-1, 0),   # Up
        (1, 0),    # Down
        (0, -1),   # Left
        (0, 1)     # Right
    ]

    for dr, dc in moves:
        new_row = row + dr
        new_col = col + dc

        if 0 <= new_row < 3 and 0 <= new_col < 3:

            new_zero = new_row * 3 + new_col

            new_state = state[:]

            new_state[zero] = new_state[new_zero]
            new_state[new_zero] = 0

            neighbors.append(new_state)

    return neighbors


def same_state(a, b):
    return a == b


def already_visited(state, visited):
    for x in visited:
        if same_state(x, state):
            return True
    return False


def bfs(start):

    queue = []
    paths = []

    queue.append(start)
    paths.append([start])

    visited = [start]

    while len(queue) > 0:

        current = queue.pop(0)
        path = paths.pop(0)

        if same_state(current, GOAL):
            return path

        neighbors = get_neighbors(current)

        for next_state in neighbors:

            if not already_visited(next_state, visited):

                visited.append(next_state)
                queue.append(next_state)
                paths.append(path + [next_state])

    return None


START = [
    8, 7, 6,
    5, 0, 4,
    3, 2, 1
]


solution = bfs(START)

if solution is None:

    print("No solution")

else:

    print("moves:", len(solution) - 1)
    print()

    for i in range(len(solution)):

        print("Step", i)
        print_state(solution[i])
